{
  "name": "memorai",
  "version": "0.5.0",
  "description": "Memory for AI agents — built to remember, recall, and reflect. Runtime-agnostic across Browser, Node.js, Bun, Deno.",
  "homepage": "https://github.com/Naeemo/memorai#readme",
  "bugs": {
    "url": "https://github.com/Naeemo/memorai/issues"
  },
  "license": "MIT",
  "author": "Naeemo <naeemo@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Naeemo/memorai.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js"
    },
    "./embeddings": {
      "types": "./dist/embeddings/index.d.ts",
      "import": "./dist/embeddings/index.js"
    },
    "./vector": {
      "types": "./dist/vector/index.d.ts",
      "import": "./dist/vector/index.js"
    },
    "./graph": {
      "types": "./dist/graph/index.d.ts",
      "import": "./dist/graph/index.js"
    },
    "./temporal": {
      "types": "./dist/temporal/index.d.ts",
      "import": "./dist/temporal/index.js"
    },
    "./working": {
      "types": "./dist/working/index.d.ts",
      "import": "./dist/working/index.js"
    },
    "./retention": {
      "types": "./dist/retention/index.d.ts",
      "import": "./dist/retention/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "typecheck": "tsc --noEmit",
    "release": "bumpp && pnpm publish",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "hnswlib-node": ">=1.0.0",
    "hnswlib-wasm": ">=0.6.0"
  },
  "peerDependenciesMeta": {
    "hnswlib-node": {
      "optional": true
    },
    "hnswlib-wasm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "bumpp": "^10.4.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.22",
    "vitest": "^3.2.4"
  }
}
